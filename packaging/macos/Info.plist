<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the macOS .app bundle (Dioxus.toml: [bundle.macos]
  info_plist_path), added for the file association in FRE-114.

  READ THIS BEFORE EDITING. dx does not merge: pointing `info_plist_path` at a
  file makes dx copy it verbatim *instead of* generating one, so every key it
  would have generated has to be repeated here. Everything above
  CFBundleDocumentTypes is exactly that — and only CFBundleDocumentTypes is
  ours.

  MIRRORED FROM dx 0.7.9, `create_macos_info_plist` in
  dioxus-cli/src/bundler/macos.rs — the function `dx bundle --package-types
  macos` reaches, via `bundle_macos_app`. That is the only plist generator that
  applies here; dioxus-cli has several others, for widget extensions,
  frameworks and iOS, and those write keys this bundle neither gets nor wants
  (CFBundleSupportedPlatforms is one of them). The function is byte-identical
  in dx 0.7.9 and 0.7.10.

  0.7.9 is the version .github/workflows/release.yml pins, which is what makes
  this mirror checkable: tests/file_associations.rs asserts the version named
  above still matches that pin, so upgrading dx cannot silently leave the
  mirror behind — it fails until someone re-reads the function.

  A hand-maintained copy of a generated file also goes stale in place: bump the
  crate version and the About box would keep reporting the old one. So the test
  re-derives every mirrored value from Cargo.toml and Dioxus.toml, and asserts
  the exact key set below — no more, no fewer. Two keys dx can emit are
  deliberately absent because dx writes them only when given config this
  project does not set: ITSAppUsesNonExemptEncryption (needs
  `provider_short_name`) and NSAppTransportSecurity (needs `exception_domain`).
  Set either in Dioxus.toml and this file has to gain the key.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleDisplayName</key>
	<string>Hubro</string>
	<key>CFBundleExecutable</key>
	<string>hubro</string>
	<key>CFBundleIconFile</key>
	<string>Hubro.icns</string>
	<key>CFBundleIdentifier</key>
	<string>no.lokander.hubro</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Hubro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.7.0</string>
	<key>CFBundleVersion</key>
	<string>0.7.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Fredrik Lokander</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!--
	  The file association itself. Two entries rather than one because the
	  extensions are not equally ours:

	  - `.sqlite` / `.sqlite3` name SQLite and nothing else, so hubro offers
	    itself as the Default handler for them.
	  - `.db` is used by a great many unrelated formats, so hubro is only ever
	    an Alternate handler for it — it stays available under "Open With" and
	    never takes the extension over from whatever the user already uses.

	  Files arrive through the `open` Apple Event rather than argv; the handler
	  for that is `Event::Opened` in src/main.rs.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>SQLite database</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>sqlite</string>
				<string>sqlite3</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Database file</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>db</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
